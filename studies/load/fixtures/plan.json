{
  "requestId": "load-client-run-001",
  "variables": {
    "replicas": {
      "fixture": 2,
      "batch": 4
    },
    "run": {
      "rate": 0.2,
      "duration": 60,
      "max_requests": 12,
      "concurrency": 4,
      "timeout": 120,
      "request_timeout": 5,
      "poll_interval": 1
    },
    "images": {
      "runner": "YOUR_REGISTRY/polyad-benchmarks-runner",
      "fixture": "YOUR_REGISTRY/polyad-benchmarks-fixture",
      "tag": "RUN"
    },
    "placement": {
      "nodeSelector": {
        "cloud.google.com/gke-nodepool": "fixtures"
      },
      "tolerations": [
        {
          "key": "dedicated",
          "operator": "Equal",
          "value": "fixtures",
          "effect": "NoSchedule"
        }
      ]
    },
    "runnerPlacement": {
      "nodeSelector": {
        "cloud.google.com/gke-nodepool": "copolyad"
      },
      "tolerations": [
        {
          "key": "dedicated",
          "operator": "Equal",
          "value": "copolyad",
          "effect": "NoSchedule"
        }
      ]
    }
  }
}
