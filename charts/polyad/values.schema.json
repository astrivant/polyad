{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "resources",
    "terminationGracePeriodSeconds",
    "replicaCount",
    "autoscaling",
    "dragonfly",
    "dragonflyOperator",
    "api"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9./:_-]*$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceList"
        },
        "limits": {
          "$ref": "#/definitions/resourceList"
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 300
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "minReplicas": {
                    "const": 1
                  },
                  "maxReplicas": {
                    "minimum": 1
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 2
                  },
                  "maxReplicas": {
                    "minimum": 2
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 3
                  },
                  "maxReplicas": {
                    "minimum": 3
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 4
                  },
                  "maxReplicas": {
                    "minimum": 4
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 5
                  },
                  "maxReplicas": {
                    "minimum": 5
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 6
                  },
                  "maxReplicas": {
                    "minimum": 6
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 7
                  },
                  "maxReplicas": {
                    "minimum": 7
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 8
                  },
                  "maxReplicas": {
                    "minimum": 8
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 9
                  },
                  "maxReplicas": {
                    "minimum": 9
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 10
                  },
                  "maxReplicas": {
                    "minimum": 10
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 11
                  },
                  "maxReplicas": {
                    "minimum": 11
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 12
                  },
                  "maxReplicas": {
                    "minimum": 12
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 13
                  },
                  "maxReplicas": {
                    "minimum": 13
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 14
                  },
                  "maxReplicas": {
                    "minimum": 14
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 15
                  },
                  "maxReplicas": {
                    "minimum": 15
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 16
                  },
                  "maxReplicas": {
                    "minimum": 16
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 17
                  },
                  "maxReplicas": {
                    "minimum": 17
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 18
                  },
                  "maxReplicas": {
                    "minimum": 18
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 19
                  },
                  "maxReplicas": {
                    "minimum": 19
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 20
                  },
                  "maxReplicas": {
                    "minimum": 20
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 21
                  },
                  "maxReplicas": {
                    "minimum": 21
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 22
                  },
                  "maxReplicas": {
                    "minimum": 22
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 23
                  },
                  "maxReplicas": {
                    "minimum": 23
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 24
                  },
                  "maxReplicas": {
                    "minimum": 24
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 25
                  },
                  "maxReplicas": {
                    "minimum": 25
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 26
                  },
                  "maxReplicas": {
                    "minimum": 26
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 27
                  },
                  "maxReplicas": {
                    "minimum": 27
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 28
                  },
                  "maxReplicas": {
                    "minimum": 28
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 29
                  },
                  "maxReplicas": {
                    "minimum": 29
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 30
                  },
                  "maxReplicas": {
                    "minimum": 30
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 31
                  },
                  "maxReplicas": {
                    "minimum": 31
                  }
                }
              },
              {
                "properties": {
                  "minReplicas": {
                    "const": 32
                  },
                  "maxReplicas": {
                    "minimum": 32
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "dragonfly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "externalUrl",
        "existingSecret",
        "persistence",
        "ha"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9./:_-]*$"
        },
        "externalUrl": {
          "type": "string",
          "pattern": "^(rediss?://[A-Za-z0-9._~:/?#@!$&()*+,;=%-]+)?$"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "size",
            "storageClass"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*Gi$"
            },
            "storageClass": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            }
          }
        },
        "ha": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "replicas",
            "topologyKey"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "replicas": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9
            },
            "topologyKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              },
              "existingSecret": {
                "const": ""
              }
            }
          },
          "then": {
            "properties": {
              "externalUrl": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "dragonflyOperator": {
      "type": "object",
      "required": [
        "nameOverride",
        "replicaCount",
        "crds"
      ],
      "properties": {
        "nameOverride": {
          "const": "dragonfly-operator"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "crds": {
          "type": "object",
          "required": [
            "install"
          ],
          "properties": {
            "install": {
              "const": false
            }
          }
        },
        "manager": {
          "type": "object",
          "properties": {
            "extraArgs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^--[^\\r\\n]+$"
              }
            }
          }
        },
        "rbacProxy": {
          "type": "object",
          "properties": {
            "extraArgs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^--[^\\r\\n]+$"
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "description": "Value for an individual key in nodeSelector."
      },
      "description": "Exact Kubernetes node-label matches, all of which must hold. Use labels for node groups or resource slices; cloud tags must first be exposed as node labels. Conflicting inherited values are rejected."
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Taint key to match. An empty key requires operator Exists and matches all keys."
          },
          "operator": {
            "type": "string",
            "enum": [
              "Exists",
              "Equal"
            ],
            "description": "Taint comparison: Equal matches key and value; Exists matches the key regardless of value. Kubernetes defaults an omitted operator to Equal."
          },
          "value": {
            "type": "string",
            "description": "Taint value to match when operator is Equal. Omit or leave empty when operator is Exists."
          },
          "effect": {
            "type": "string",
            "enum": [
              "",
              "NoSchedule",
              "PreferNoSchedule",
              "NoExecute"
            ],
            "description": "Taint effect to match. An empty effect matches all effects: NoSchedule, PreferNoSchedule and NoExecute."
          },
          "tolerationSeconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Seconds a pod may remain bound after a matching NoExecute taint. Omission tolerates that taint indefinitely; zero requests immediate eviction."
          }
        },
        "description": "One entry in tolerations.",
        "additionalProperties": false
      },
      "description": "Kubernetes taints tolerated by descendant pods, deduplicated across scopes. Tolerations allow placement on tainted nodes; they do not select or guarantee a node."
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingSecret",
        "rateLimit",
        "gateway"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "requestsPerMinute"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "requestsPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "create",
            "name",
            "namespace",
            "className",
            "sectionName",
            "hostnames",
            "tlsSecret"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
            },
            "namespace": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
            },
            "className": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
            },
            "sectionName": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
              "minLength": 1
            },
            "hostnames": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^(\\*\\.)?[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              }
            },
            "tlsSecret": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "create": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "name": {
                    "minLength": 1
                  },
                  "tlsSecret": {
                    "const": ""
                  },
                  "className": {
                    "const": ""
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "create": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "className": {
                    "minLength": 1
                  },
                  "name": {
                    "const": ""
                  },
                  "namespace": {
                    "const": ""
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "gateway": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^[1-9][0-9]*m$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi)$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "autoscaling": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "resources": {
            "required": [
              "requests"
            ],
            "properties": {
              "requests": {
                "required": [
                  "cpu"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
