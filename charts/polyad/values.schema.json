{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "resources",
    "terminationGracePeriodSeconds",
    "replicaCount",
    "autoscaling",
    "dragonfly"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9./:_-]*$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceList"
        },
        "limits": {
          "$ref": "#/definitions/resourceList"
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 300
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "dragonfly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "externalUrl",
        "existingSecret",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "externalUrl": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "size",
            "storageClass"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*Gi$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^[1-9][0-9]*m$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi)$"
        }
      }
    }
  }
}
