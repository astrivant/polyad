{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/astrivant/polyad/raw/main/pkg/polyad-schemas/polyad_schemas/resources/temporaryconnection.v1alpha1.schema.json",
  "title": "polyad.astrivant.com TemporaryConnection v1alpha1",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "polyad.astrivant.com/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "TemporaryConnection"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "description": "Request an immutable, expiring connection within a persisted graph boundary.",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "Client idempotency key retained with the receipt.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace of the target graph and receipt.",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Graph",
            "PolyGraph",
            "ReplicaGroup"
          ],
          "description": "Target boundary kind."
        },
        "graph": {
          "type": "string",
          "description": "Persisted instance name, not a reusable template name.",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "graphUid": {
          "type": "string",
          "description": "Expected graph incarnation.",
          "minLength": 1,
          "maxLength": 128
        },
        "source": {
          "type": "string",
          "description": "Sending logical node or replica ordinal.",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "target": {
          "type": "string",
          "description": "Receiving logical node or replica ordinal.",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "ttlSeconds": {
          "type": "integer",
          "description": "Lifetime measured from Kubernetes receipt creation.",
          "minimum": 1,
          "maximum": 86400
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Select a transport port on the destination workload.",
            "properties": {
              "port": {
                "type": "integer",
                "description": "Destination transport port.",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "TCP",
                  "UDP",
                  "SCTP"
                ],
                "description": "Transport protocol."
              }
            },
            "required": [
              "port"
            ]
          },
          "description": "Destination grants, empty for topology only.",
          "maxItems": 32
        },
        "bidirectional": {
          "type": "boolean",
          "description": "Whether to add the reverse connection with the same ports."
        },
        "peers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "description": "Address one logical service with its exact graph incarnation and execution cluster.",
            "properties": {
              "cluster": {
                "type": "string",
                "description": "Registered cluster hosting this endpoint; empty selects local execution."
              },
              "namespace": {
                "type": "string",
                "description": "Namespace of the graph instance."
              },
              "kind": {
                "type": "string",
                "description": "Graph, PolyGraph or ReplicaGroup boundary kind."
              },
              "graph": {
                "type": "string",
                "description": "Persisted graph instance name."
              },
              "graphUid": {
                "type": "string",
                "description": "Graph UID fencing deletion and replacement."
              },
              "node": {
                "type": "string",
                "description": "Logical node or replica ordinal within that boundary."
              }
            },
            "required": [
              "cluster",
              "namespace",
              "kind",
              "graph",
              "graphUid",
              "node"
            ]
          },
          "description": "Exact service participants for an atlas-coordinated connection."
        },
        "requester": {
          "type": "object",
          "required": [
            "username",
            "uid"
          ],
          "properties": {
            "cluster": {
              "type": "string",
              "maxLength": 63
            },
            "username": {
              "type": "string",
              "maxLength": 320,
              "pattern": "^system:serviceaccount:[a-z0-9-]+:[a-z0-9.-]+$"
            },
            "uid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "required": [
        "requestId",
        "namespace",
        "kind",
        "graph",
        "graphUid",
        "source",
        "target",
        "ttlSeconds",
        "requester"
      ],
      "x-kubernetes-validations": [
        {
          "rule": "self == oldSelf",
          "message": "Connection intent is immutable; a new requestId creates a new deadline."
        },
        {
          "rule": "self.source != self.target",
          "message": "Temporary connections require distinct endpoints."
        }
      ]
    },
    "status": {
      "type": "object",
      "default": {},
      "x-kubernetes-preserve-unknown-fields": true
    }
  },
  "$comment": "Generated from charts/polyad-crds/crds/temporaryconnections.yaml; do not edit this artifact."
}
