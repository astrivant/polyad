{
  "uid": "polyad-study",
  "title": "Polyad load study",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "polyad",
    "benchmarks"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API arrival rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (component) (polyad_component_requests_per_second{namespace=\"$namespace\"})",
          "legendFormat": "{{ component }}{{ writer }}{{ kind }}{{ role }}{{ state }}{{ pod }}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Operator replicas reporting",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (component) (polyad_component_reporting_replicas{namespace=\"$namespace\"})",
          "legendFormat": "{{ component }}{{ writer }}{{ kind }}{{ role }}{{ state }}{{ pod }}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pending Kubernetes writes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (writer) (polyad_kubernetes_writes_queued{namespace=\"$namespace\"})",
          "legendFormat": "{{ component }}{{ writer }}{{ kind }}{{ role }}{{ state }}{{ pod }}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Oldest queued write",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (writer) (polyad_kubernetes_writes_oldest_queued_seconds{namespace=\"$namespace\"})",
          "legendFormat": "{{ component }}{{ writer }}{{ kind }}{{ role }}{{ state }}{{ pod }}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Shared inbound backlog",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (shard, state) (polyad_inbound_updates{namespace=\"$namespace\"}))",
          "legendFormat": "{{ component }}{{ writer }}{{ kind }}{{ role }}{{ state }}{{ pod }}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Current graph observations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (polyad_graph_status_observations{namespace=\"$namespace\"})",
          "legendFormat": "{{ component }}{{ writer }}{{ kind }}{{ role }}{{ state }}{{ pod }}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Tracked objects",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (kind, role) (polyad_tracked_objects{namespace=\"$namespace\"})",
          "legendFormat": "{{ component }}{{ writer }}{{ kind }}{{ role }}{{ state }}{{ pod }}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Operator container memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",container=\"operator\"})",
          "legendFormat": "{{ component }}{{ writer }}{{ kind }}{{ role }}{{ state }}{{ pod }}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Graph boundary dimensions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster, graph_namespace, kind, name, view, dimension) (polyad_graph_topology{namespace=\"$namespace\",view=\"declared\",dimension=~\"nodeCount|admission.edgeCount|connections.edgeCount|admission.depth|admission.breadth\"})",
          "legendFormat": "{{ cluster }} {{ kind }}/{{ name }} {{ dimension }}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Cheeger exact values and witnessed bounds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster, graph_namespace, kind, name, rule, relation, source, stage, layout, statistic) (polyad_graph_cheeger_result{namespace=\"$namespace\",statistic=~\"constant|upperBound\"})",
          "legendFormat": "{{ cluster }} {{ name }} {{ source }} {{ layout }} {{ statistic }}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Cheeger search work and limits",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster, graph_namespace, kind, name, rule, relation, source, stage, layout, statistic) (polyad_graph_cheeger_result{namespace=\"$namespace\",statistic=~\"evaluatedCuts|skippedPriorityCuts\"})",
          "legendFormat": "{{ cluster }} {{ name }} {{ source }} {{ statistic }}"
        },
        {
          "refId": "B",
          "expr": "max by (cluster, graph_namespace, kind, name, rule, relation, source, stage, layout, parameter) (polyad_graph_cheeger_input{namespace=\"$namespace\",parameter=\"maxCuts\"})",
          "legendFormat": "{{ cluster }} {{ name }} {{ source }} {{ parameter }}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Cheeger calculation time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster, graph_namespace, kind, name, rule, relation, source, stage, layout) (polyad_graph_cheeger_result{namespace=\"$namespace\",statistic=\"durationSeconds\"})",
          "legendFormat": "{{ cluster }} {{ name }} {{ source }} {{ layout }}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Spectral summaries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster, graph_namespace, kind, name, rule, relation, statistic) (polyad_graph_spectrum{namespace=\"$namespace\"})",
          "legendFormat": "{{ cluster }} {{ name }} {{ rule }} {{ statistic }}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Application Cheeger targets and measurements",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster, graph_namespace, kind, name, parameter) (polyad_graph_throughput{namespace=\"$namespace\",parameter=~\"currentCheeger|proposedCheeger|target.minimum|target.maximum\"})",
          "legendFormat": "{{ cluster }} {{ name }} {{ parameter }}"
        }
      ]
    },
    {
      "id": 15,
      "title": "Run traces",
      "description": "API submissions, receipt reads and asynchronous activation decisions for this run. Requires enabled operator tracing and Tempo. Metrics in the other panels are namespace aggregates.",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ span.polyad.request.id =~ `${run_id:regex}(-[0-9]{5})?` }",
          "limit": 100,
          "tableType": "traces"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Trace search (Tempo)",
      "type": "link",
      "url": "/explore",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "textbox",
        "current": {
          "text": "polyad",
          "value": "polyad"
        },
        "label": "Operator namespace"
      },
      {
        "name": "run_id",
        "type": "textbox",
        "current": {
          "text": "unset",
          "value": "unset"
        },
        "label": "Run ID"
      }
    ]
  }
}
