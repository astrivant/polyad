{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "controller",
    "flux",
    "revision",
    "valueFiles",
    "values",
    "automatedSync",
    "benchmarks"
  ],
  "properties": {
    "controller": {
      "type": "string",
      "enum": ["argocd", "flux"]
    },
    "flux": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revisionType", "interval"],
      "properties": {
        "revisionType": {"type": "string", "enum": ["branch", "tag", "commit"]},
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"}
      }
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "valueFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "values": {
      "type": "string"
    },
    "automatedSync": {
      "type": "boolean"
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "valueFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "values": {
          "type": "string"
        },
        "automatedSync": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "valueFiles",
        "values",
        "automatedSync"
      ]
    }
  }
}
