{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/astrivant/polyad/raw/main/pkg/polyad-types/polyad_types/schemas/events.schema.json",
  "title": "Polyad event AST",
  "description": "Transport-neutral public observations and stream controls; SSE maps id/event/data to this JSON envelope.",
  "oneOf": [
    {
      "$ref": "#/$defs/GraphEvent"
    },
    {
      "$ref": "#/$defs/TopologyEvent"
    },
    {
      "$ref": "#/$defs/ConnectionEvent"
    },
    {
      "$ref": "#/$defs/ControlEvent"
    },
    {
      "$ref": "#/$defs/HeartbeatEvent"
    }
  ],
  "$defs": {
    "GraphEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Replay cursor to commit after handling.",
          "pattern": "^(?:0|[1-9][0-9]{0,19})-(?:0|[1-9][0-9]{0,19})$"
        },
        "data": {
          "$ref": "#/$defs/GraphObservation",
          "description": "Lifecycle payload."
        },
        "event": {
          "type": "string",
          "enum": [
            "graph"
          ],
          "description": "Transport discriminator."
        }
      },
      "required": [
        "id",
        "event",
        "data"
      ]
    },
    "GraphObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "Kubernetes resource kind."
        },
        "namespace": {
          "type": "string",
          "description": "Resource namespace."
        },
        "name": {
          "type": "string",
          "description": "Resource name."
        },
        "uid": {
          "type": "string",
          "description": "Exact resource incarnation."
        },
        "cluster": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Registered cluster; omitted for local observations."
        },
        "apiVersion": {
          "type": "string",
          "description": "Kubernetes API group/version."
        },
        "resourceVersion": {
          "type": "string",
          "description": "Opaque Kubernetes version; not a topology revision."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "Desired-state generation."
        },
        "type": {
          "type": "string",
          "enum": [
            "observation",
            "deleting"
          ],
          "description": "Ordinary observation or deletion in progress."
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventOwner"
          },
          "description": "Public owner references."
        },
        "ancestry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventIdentity"
          },
          "description": "Verified graph ancestors used for visibility."
        },
        "audit": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Public composition, request and node labels."
        },
        "status": {
          "$ref": "#/$defs/EventStatus",
          "description": "Selected lifecycle and policy observations."
        },
        "resources": {
          "type": "object",
          "additionalProperties": {},
          "description": "Extensible resource-count metrics JSON."
        }
      },
      "required": [
        "kind",
        "namespace",
        "name",
        "uid",
        "apiVersion",
        "resourceVersion",
        "generation",
        "type",
        "owners",
        "ancestry",
        "audit",
        "status",
        "resources"
      ]
    },
    "EventOwner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "Owner kind."
        },
        "name": {
          "type": "string",
          "description": "Owner name."
        },
        "uid": {
          "type": "string",
          "description": "Exact owner incarnation."
        }
      },
      "required": [
        "kind",
        "name",
        "uid"
      ]
    },
    "EventIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "Kubernetes resource kind."
        },
        "namespace": {
          "type": "string",
          "description": "Resource namespace."
        },
        "name": {
          "type": "string",
          "description": "Resource name."
        },
        "uid": {
          "type": "string",
          "description": "Exact resource incarnation."
        },
        "cluster": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Registered cluster; omitted for local observations."
        }
      },
      "required": [
        "kind",
        "namespace",
        "name",
        "uid"
      ]
    },
    "EventStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resource-specific lifecycle phase."
        },
        "ready": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Observed readiness."
        },
        "completed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Observed completion."
        },
        "failed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Observed failure."
        },
        "observedGeneration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Desired generation represented by this status."
        },
        "activations": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ],
          "description": "Resource-specific activation status JSON."
        },
        "throughput": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ],
          "description": "Soul searching observations, including traffic and Cheeger targets."
        }
      }
    },
    "TopologyEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Replay cursor to commit after handling.",
          "pattern": "^(?:0|[1-9][0-9]{0,19})-(?:0|[1-9][0-9]{0,19})$"
        },
        "data": {
          "$ref": "#/$defs/TopologyObservation",
          "description": "Structural change payload."
        },
        "event": {
          "type": "string",
          "enum": [
            "topology"
          ],
          "description": "Transport discriminator."
        }
      },
      "required": [
        "id",
        "event",
        "data"
      ]
    },
    "TopologyObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "Kubernetes resource kind."
        },
        "namespace": {
          "type": "string",
          "description": "Resource namespace."
        },
        "name": {
          "type": "string",
          "description": "Resource name."
        },
        "uid": {
          "type": "string",
          "description": "Exact resource incarnation."
        },
        "cluster": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Registered cluster; omitted for local observations."
        },
        "apiVersion": {
          "type": "string",
          "description": "Kubernetes API group/version."
        },
        "resourceVersion": {
          "type": "string",
          "description": "Opaque Kubernetes version; not a topology revision."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "Desired-state generation."
        },
        "type": {
          "type": "string",
          "enum": [
            "topology"
          ],
          "description": "Topology payload discriminator."
        },
        "ancestry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventIdentity"
          },
          "description": "Verified graph ancestors."
        },
        "revision": {
          "type": "string",
          "description": "Structural revision, independent of resourceVersion."
        },
        "snapshot": {
          "type": "string",
          "description": "Relative topology API path, including a cluster selector when needed."
        },
        "valid": {
          "type": "boolean",
          "description": "Whether the current topology can be represented."
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of logical nodes in the snapshot."
        },
        "connectionCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of declared connections in the snapshot."
        }
      },
      "required": [
        "kind",
        "namespace",
        "name",
        "uid",
        "apiVersion",
        "resourceVersion",
        "generation",
        "type",
        "ancestry",
        "revision",
        "snapshot",
        "valid",
        "nodeCount",
        "connectionCount"
      ]
    },
    "ConnectionEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Replay cursor to commit after handling.",
          "pattern": "^(?:0|[1-9][0-9]{0,19})-(?:0|[1-9][0-9]{0,19})$"
        },
        "data": {
          "$ref": "#/$defs/ConnectionObservation",
          "description": "Local or atlas consent payload."
        },
        "event": {
          "type": "string",
          "enum": [
            "connection"
          ],
          "description": "Transport discriminator."
        }
      },
      "required": [
        "id",
        "event",
        "data"
      ]
    },
    "ConnectionObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "connection"
          ],
          "description": "Consent event payload discriminator."
        },
        "graph": {
          "$ref": "#/$defs/EventIdentity",
          "description": "Graph in whose stream this participant is visible."
        },
        "connection": {
          "$ref": "#/$defs/ConnectionReceipt",
          "description": "Public receipt without credentials or workload templates."
        },
        "ancestry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventIdentity"
          },
          "description": "Verified ancestors of the visible graph."
        },
        "participant": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "source",
                "target"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Atlas projection side; omitted for local receipts."
        },
        "apiVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "API version of a locally observed receipt."
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "TemporaryConnection"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Kind of a locally observed receipt."
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Local receipt namespace."
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Local receipt name."
        },
        "uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Local receipt UID."
        },
        "resourceVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Local receipt resource version."
        },
        "generation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Local receipt generation."
        },
        "cluster": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Registered cluster of the local receipt."
        },
        "owners": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EventOwner"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Local receipt owners."
        },
        "audit": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Public local receipt labels."
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Selected local lifecycle observations."
        },
        "resources": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ],
          "description": "Local resource-count observations."
        }
      },
      "required": [
        "type",
        "graph",
        "connection",
        "ancestry"
      ]
    },
    "ConnectionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "description": "Stable proposal idempotency key."
        },
        "name": {
          "type": "string",
          "description": "Receipt resource name."
        },
        "namespace": {
          "type": "string",
          "description": "Receipt namespace."
        },
        "uid": {
          "type": "string",
          "description": "Receipt incarnation required by approval requests."
        },
        "expiresAt": {
          "type": "string",
          "description": "Immutable ISO-8601 deadline."
        },
        "target": {
          "$ref": "#/$defs/ConnectionTarget",
          "description": "Exact requested edge."
        },
        "status": {
          "type": "object",
          "additionalProperties": {},
          "description": "Resource-specific admission and negotiation status JSON."
        },
        "consent": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "Approve",
              "Reject"
            ]
          },
          "description": "Verified endpoint decisions."
        },
        "peers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ServiceEndpoint"
          },
          "description": "Cluster-qualified source and target for atlas proposals."
        },
        "revokeRequested": {
          "type": "boolean",
          "description": "Whether revocation has been requested."
        }
      },
      "required": [
        "requestId",
        "name",
        "namespace",
        "uid",
        "expiresAt",
        "target",
        "status",
        "consent",
        "peers",
        "revokeRequested"
      ]
    },
    "ConnectionTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Graph",
            "PolyGraph",
            "ReplicaGroup"
          ],
          "description": "Boundary kind."
        },
        "graph": {
          "type": "string",
          "description": "Boundary name."
        },
        "graphUid": {
          "type": "string",
          "description": "Boundary incarnation."
        },
        "source": {
          "type": "string",
          "description": "Source node."
        },
        "target": {
          "type": "string",
          "description": "Target node."
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetworkPort"
          },
          "description": "Granted destination ports and protocols."
        },
        "bidirectional": {
          "type": "boolean",
          "description": "Whether the proposal also grants reverse traffic."
        }
      },
      "required": [
        "kind",
        "graph",
        "graphUid",
        "source",
        "target",
        "ports",
        "bidirectional"
      ]
    },
    "NetworkPort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Destination port from 1 through 65535."
        },
        "protocol": {
          "type": "string",
          "enum": [
            "TCP",
            "UDP",
            "SCTP"
          ],
          "description": "Transport protocol."
        }
      },
      "required": [
        "port"
      ]
    },
    "ServiceEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "string",
          "description": "Registered cluster hosting this endpoint; empty selects local execution."
        },
        "namespace": {
          "type": "string",
          "description": "Namespace of the graph instance."
        },
        "kind": {
          "type": "string",
          "description": "Graph, PolyGraph or ReplicaGroup boundary kind."
        },
        "graph": {
          "type": "string",
          "description": "Persisted graph instance name."
        },
        "graphUid": {
          "type": "string",
          "description": "Graph UID fencing deletion and replacement."
        },
        "node": {
          "type": "string",
          "description": "Logical node or replica ordinal within that boundary."
        }
      },
      "required": [
        "cluster",
        "namespace",
        "kind",
        "graph",
        "graphUid",
        "node"
      ]
    },
    "ControlEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "reset",
            "unavailable"
          ],
          "description": "Refresh-snapshot or reconnect instruction."
        },
        "data": {
          "$ref": "#/$defs/StreamControl",
          "description": "Recovery reason."
        },
        "id": {
          "type": "string",
          "enum": [
            ""
          ],
          "description": "Controls never acknowledge a stream position."
        }
      },
      "required": [
        "id",
        "event",
        "data"
      ]
    },
    "StreamControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "description": "Human-readable recovery instruction."
        }
      },
      "required": [
        "reason"
      ]
    },
    "HeartbeatEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/Heartbeat",
          "description": "Empty heartbeat object."
        },
        "event": {
          "type": "string",
          "enum": [
            "heartbeat"
          ],
          "description": "Heartbeat discriminator."
        },
        "id": {
          "type": "string",
          "enum": [
            ""
          ],
          "description": "Heartbeats never acknowledge a stream position."
        }
      },
      "required": [
        "id",
        "event",
        "data"
      ]
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "EventStreamSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxEventBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216,
          "description": "Maximum complete SSE record or WebSocket JSON frame in UTF-8 bytes."
        },
        "readBatchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "description": "Maximum observations retrieved per subscriber read."
        },
        "pollIntervalSeconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 5,
          "description": "Delay before another empty-stream read; also bounds idle heartbeat cadence."
        }
      }
    }
  }
}
