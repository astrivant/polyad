{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/astrivant/polyad/raw/main/pkg/polyad-types/polyad_types/schemas/dragonflypool.v1alpha1.schema.json",
  "title": "Polyad DragonflyPool v1alpha1",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "polyad.astrivant.com/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "DragonflyPool"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "replicas",
        "minReplicas",
        "maxReplicas"
      ],
      "x-kubernetes-validations": [
        {
          "rule": "self.minReplicas <= self.maxReplicas",
          "message": "minReplicas must not exceed maxReplicas"
        },
        {
          "rule": "self.replicas >= self.minReplicas && self.replicas <= self.maxReplicas",
          "message": "replicas must stay within the configured bounds"
        }
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "readyReplicas": {
          "type": "integer",
          "minimum": 0
        },
        "labelSelector": {
          "type": "string"
        },
        "observedGeneration": {
          "type": "integer"
        },
        "phase": {
          "type": "string"
        }
      }
    }
  }
}
