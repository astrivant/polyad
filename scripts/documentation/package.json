{
  "name": "polyad-documentation-checks",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "check": "node check-markdown.mjs",
    "test": "node --test *.test.mjs ../release/*.test.cjs ../coverage/*.test.mjs",
    "lint": "cd ../.. && scripts/documentation/node_modules/.bin/eslint --config scripts/documentation/eslint.config.mjs scripts/documentation/*.mjs scripts/release/*.cjs scripts/coverage/*.mjs",
    "markdown:lint": "node lint-markdown.mjs"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "katex": "0.19.0",
    "markdownlint": "0.42.0",
    "mermaid": "12.2.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  }
}
