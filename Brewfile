# Native host tools. Helm and kubectl use the pins in .tool-versions via asdf.
brew "asdf"
brew "bash"
brew "curl"
brew "jq"
brew "shellcheck"
brew "shfmt"

# Application image builds still need a running Docker daemon (for example, Docker Desktop).
brew "docker"
brew "docker-buildx"
brew "crane"

# Local clusters: Minikube uses QEMU/HVF VMs on macOS, not Docker nodes.
brew "minikube"
brew "qemu"
brew "socket_vmnet"
brew "kind"
