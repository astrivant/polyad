      "reason": "Three-way literal rules with one unchanged owner group; changed owners or syntax require review."
    },
    {
      "output": "pkg/polyad-schemas/polyad_schemas/resources/external-secrets-LICENSE",
      "inputs": [
        "schemas/licenses/external-secrets-LICENSE"
      ],
      "renderer": "copy",
