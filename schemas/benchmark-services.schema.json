{
  "type": "object",
  "properties": {
    "reloader": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Install the pinned reloader dependency; disable to use an administrator-managed installation."
        },
        "reloader": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "watchGlobally": {
              "type": "boolean"
            },
            "ignoreJobs": {
              "type": "boolean"
            },
            "ignoreCronJobs": {
              "type": "boolean"
            },
            "reloadStrategy": {
              "type": "string"
            },
            "deployment": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "nodeSelector": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "cloud.google.com/gke-nodepool": {
                      "type": "string"
                    }
                  }
                },
                "tolerations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "x-polyad-freeform": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "operatorNamespace": {
          "type": "string",
          "description": "Namespace containing the operator metrics Service."
        },
        "operatorRelease": {
          "type": "string",
          "description": "Helm release owning the operator metrics Service."
        },
        "scrapeInterval": {
          "type": "string",
          "description": "Prometheus scrape interval; 5s resolves short benchmark bursts."
        },
        "metricsSecret": {
          "type": "string",
          "description": "Optional existing bearer credential Secret in this chart namespace; empty for the private demo."
        },
        "metricsSecretKey": {
          "type": "string",
          "description": "Key containing the bearer token when metricsSecret is set."
        },
        "scrapeOperator": {
          "type": "boolean",
          "description": "Create a ServiceMonitor for direct operator scrapes; false when an agent already remote-writes these series."
        }
      },
      "description": "Operator metric scraping and the study dashboard. Requires Prometheus Operator CRDs when enabled."
    },
