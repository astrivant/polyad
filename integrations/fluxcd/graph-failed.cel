!(has(spec.templateOnly) && spec.templateOnly) &&
has(status.observedGeneration) && status.observedGeneration == metadata.generation && (
  (has(status.phase) && status.phase in ['Failed', 'Invalid']) ||
  (has(status.failed) && status.failed) || (
    has(status.metrics) && has(status.metrics.observedGeneration) &&
    status.metrics.observedGeneration == metadata.generation &&
    has(status.metrics.rollup) && has(status.metrics.rollup.observedGeneration) &&
    status.metrics.rollup.observedGeneration == metadata.generation && (
      (has(status.metrics.rollup.failedLeafNodes) && status.metrics.rollup.failedLeafNodes > 0) ||
      (has(status.metrics.rollup.graphsByPhase) && ['Failed', 'Invalid'].exists(p,
        p in status.metrics.rollup.graphsByPhase && status.metrics.rollup.graphsByPhase[p] > 0))
    )
  )
)
